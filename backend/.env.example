# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (PostgreSQL). Never commit a real connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biomedxpert?schema=public"

# Auth. Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS (comma separated origins), e.g. https://biomed-xpert-crm.vercel.app
CORS_ORIGIN=http://localhost:5173

# Cookies. When the web app and API are on different sites (Vercel + Render),
# set COOKIE_SAMESITE=none and COOKIE_SECURE=true so sessions survive a page reload.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Proxies in front of the API (1 on Render/Railway/Heroku, 0 locally)
TRUST_PROXY=0
# Requests per 15 minutes per IP
API_RATE_LIMIT=1000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
