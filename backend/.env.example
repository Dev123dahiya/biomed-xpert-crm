# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:dev%407404@localhost:7404/biomed_xpert?schema=public"
# Auth
JWT_ACCESS_SECRET="biomed_xpert_access_secret_2026_local_development"

JWT_REFRESH_SECRET="biomed_xpert_refresh_secret_2026_local_development"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS (comma separated origins)
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
